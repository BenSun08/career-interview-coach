# Proposed development inputs for T001; no application reads this file yet.
# Copy to .env when settings exist. Loading/parsing .env is not implemented.
# Values below describe synthetic local development, not deployment settings.
CAREER_HELPER_ENV=development
CAREER_HELPER_DEBUG=false
CAREER_HELPER_BIND_HOST=127.0.0.1
CAREER_HELPER_PORT=8000
CAREER_HELPER_ALLOWED_HOSTS=localhost,127.0.0.1

# Repository-relative private roots, separate for development and tests.
CAREER_HELPER_DATA_ROOT=.local/dev
CAREER_HELPER_TEST_DATA_ROOT=.local/test

# Generate a local secret and provision the owner during T001/W1.
# Missing values must fail closed once settings and owner checks exist.
CAREER_HELPER_SECRET_KEY=
CAREER_HELPER_OWNER_ID=

# Fixture mode must deny external traffic; live mode requires qualification
# plus per-purpose user consent. These flags do not implement those guards.
CAREER_HELPER_FIXTURE_MODE=true
CAREER_HELPER_EXTERNAL_NETWORK_ENABLED=false
CAREER_HELPER_JOB_SOURCE_ENABLED=false
CAREER_HELPER_COACHING_ENABLED=false
CAREER_HELPER_SPEECH_ENABLED=false
