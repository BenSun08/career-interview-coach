# Reference values for local development. Django reads process environment
# variables; this file is not parsed automatically. No secrets are included.
CAREER_HELPER_ENV=development
CAREER_HELPER_DEBUG=true
CAREER_HELPER_BIND_HOST=127.0.0.1
CAREER_HELPER_PORT=8000
CAREER_HELPER_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Repository-relative private synthetic roots, separate for development/tests.
CAREER_HELPER_DATA_ROOT=.local/dev-synthetic
CAREER_HELPER_TEST_DATA_ROOT=.local/test

# Local development generates a process-only secret when this is blank.
# Production settings require an explicit secret supplied outside the repo.
CAREER_HELPER_SECRET_KEY=
CAREER_HELPER_OWNER_ID=

# No provider adapters are part of the setup slice.
CAREER_HELPER_FIXTURE_MODE=true
CAREER_HELPER_EXTERNAL_NETWORK_ENABLED=false
CAREER_HELPER_JOB_SOURCE_ENABLED=false
CAREER_HELPER_COACHING_ENABLED=false
CAREER_HELPER_SPEECH_ENABLED=false
