{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "career_helper/static/career_helper/**/*.js",
    "playwright.config.js",
    "tests/browser-unit/**/*.mjs",
    "tests/e2e/**/*.js"
  ],
  "exclude": ["node_modules", "staticfiles", "playwright-report", "test-results"]
}
